{
	"//": "Typecheck the companion server + the www/src it reuses (Node target).",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [ "ES2022", "DOM" ],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [ "node" ],
		"noEmit": true
	},
	"include": [ "server/**/*.ts", "www/src/**/*.ts", "test/server/**/*.ts", "vitest.server.config.ts" ]
}
