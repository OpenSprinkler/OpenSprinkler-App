{
	"//": "Scaffold-scoped TS config (Phase 1 modernization). Covers only the new typed API/seam code and its tests; the legacy www/js is unaffected (governed by jsconfig.json).",
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [ "ES2020", "DOM" ],
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [ "vitest/globals", "node" ],
		"noEmit": true
	},
	"include": [ "app/**/*.ts", "demo/**/*.ts", "www/src/**/*.ts", "test/*.spec.ts", "vitest.config.ts", "vitest.live.config.ts" ]
}
