{
	"name": "opensprinkler",
	"version": "0.0.0",
	"description": "Designed to allow intuitive control of the OpenSprinkler irrigation controller.",
	"keywords": [
		"sprinklers",
		"opensprinkler",
		"sprinkler",
		"water"
	],
	"homepage": "https://github.com/OpenSprinkler/OpenSprinkler-App",
	"bugs": {
		"url": "https://github.com/OpenSprinkler/OpenSprinkler-App/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/OpenSprinkler/OpenSprinkler-App.git"
	},
	"license": "AGPL-3.0",
	"author": "Samer Albahra",
	"main": "index.html",
	"scripts": {
		"audit": "npm audit --audit-level=low",
		"audit:production": "npm audit --omit=dev --audit-level=low",
		"build:app": "vite build app",
		"build:firmware": "node scripts/build-firmware.mjs",
		"build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap=external --sources-content=false --outfile=dist-server/index.mjs",
		"capture": "node scripts/capture-fixtures.mjs",
		"ci": "npm run ci:checks && npm test",
		"ci:checks": "npm run audit && npm run security:scan && npm run lint && npm run lint:css && npm run typecheck && npm run typecheck:server && npm run test:contract && npm run test:server && npm run build:app && npm run build:server && npm run demo:build && npm run build:firmware",
		"ci:proxmox": "npm run ci:checks && npm run test:browser:container && npm run test:container",
		"companion": "tsx server/index.ts",
		"demo": "vite demo",
		"demo:build": "vite build demo",
		"deps:rebuild": "npm rebuild --ignore-scripts=false better-sqlite3 esbuild fsevents",
		"lint": "eslint \"www/js/**/*.js\" www/sw.js \"app/public/**/*.js\" \"scripts/**/*.mjs\"",
		"lint:css": "node scripts/lint-css.mjs",
		"localization:push-english": "node scripts/localization.mjs push-english",
		"localization:update": "node scripts/localization.mjs update",
		"prepare": "husky",
		"security:scan": "node scripts/check-tracked-secrets.mjs",
		"start": "npx http-server --port 8080 --cors '*' -c-1 ./www",
		"test": "node scripts/run-karma.mjs",
		"test:browser:container": "sh scripts/run-karma-container.sh",
		"test:container": "sh scripts/smoke-companion-container.sh",
		"test:contract": "vitest run",
		"test:server": "vitest run --config vitest.server.config.ts",
		"typecheck": "tsc -p tsconfig.json",
		"typecheck:server": "tsc -p tsconfig.server.json",
		"verify:live": "vitest run --config vitest.live.config.ts"
	},
	"lint-staged": {
		"package.json": "sort-package-json"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.11",
		"better-sqlite3": "^12.10.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/jsdom": "^28.0.3",
		"archiver": "^8.0.0",
		"chai": "^4.5.0",
		"cordova": "^13.0.0",
		"cordova-android": "^14.0.1",
		"cordova-ios": "^7.1.1",
		"cordova-plugin-3dtouch": "^1.3.8",
		"cordova-plugin-geolocation": "^4.1.0",
		"cordova-plugin-inappbrowser": "^6.0.1",
		"cordova-plugin-networkinterface": "^2.2.0",
		"cordova-plugin-statusbar": "^3.0.0",
		"cordova-plugin-transport-security": "^0.1.2",
		"csslint": "^1.0.5",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"gettext-parser": "^9.1.1",
		"globals": "^15.12.0",
		"http-server": "^14.1.1",
		"husky": "^9.1.6",
		"jquery": "^3.7.1",
		"jquery-migrate": "^3.4.1",
		"jsdom": "^29.1.1",
		"lint-staged": "^15.2.10",
		"mocha": "^11.7.6",
		"nise": "^6.1.5",
		"sinon": "^22.1.0",
		"sort-package-json": "^2.10.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.8"
	},
	"packageManager": "npm@10.9.8",
	"engines": {
		"node": ">=22.13.0",
		"npm": ">=10.9.0"
	},
	"cordova": {
		"plugins": {
			"cordova-plugin-3dtouch": {},
			"cordova-plugin-geolocation": {
				"GPS_REQUIRED": "true"
			},
			"cordova-plugin-networkinterface": {},
			"cordova-plugin-statusbar": {},
			"cordova-plugin-transport-security": {},
			"cordova-plugin-inappbrowser": {}
		},
		"platforms": [
			"android",
			"ios"
		]
	},
	"overrides": {
		"ios-sim": {
			"simctl": {
				".": "2.0.3",
				"shelljs": "0.10.0"
			}
		},
		"mocha": {
			"diff": "9.0.0",
			"glob": "13.0.6",
			"minimatch": "10.2.5",
			"serialize-javascript": "7.0.7"
		},
		"xcode": {
			"uuid": "11.1.1"
		}
	}
}
