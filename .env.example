# Copy with `install -m 600 .env.example .env`; never leave controller/token secrets world-readable.
# --- controller ---
CONTROLLER_BASE=http://192.0.2.10/
CONTROLLER_PW=
# Replace the RFC 5737 example address and supply the password only in your untracked .env file.
# CONTROLLER_ID=my-house        # optional; defaults to device MAC (stable across DHCP changes)
# CONTROLLER_FWV=212            # only to explicitly approve verified pre-2.1.3 cleartext auth

# --- collection / retention ---
POLL_INTERVAL_SEC=300
HISTORY_MAX_DAYS=90
LOG_BACKFILL_DAYS=2
CONTROLLER_TIMEOUT_MS=10000

# --- service ---
PORT=8080
# Direct `npm run companion` defaults to loopback; the container overrides this internally.
LISTEN_HOST=127.0.0.1
HOST_PORT=8080
BIND_ADDRESS=127.0.0.1
# Direct-process default. Docker Compose overrides this to the mounted /data volume.
DATABASE_PATH=./data/data.db
# Defaults to the controller origin. Add comma-separated dashboard origins for cross-origin API use.
API_ALLOWED_ORIGINS=
# Leave blank for loopback-only use. If BIND_ADDRESS is widened, terminate HTTPS at a trusted
# reverse proxy and use a random 16-512 character visible-ASCII token. Both the dashboard document
# and companion API must use HTTPS; never put this token in a page loaded over LAN HTTP.
API_TOKEN=

# --- container user (linuxserver-style; owner of /data) ---
PUID=1000
PGID=1000
TZ=America/Chicago

# --- stack config dir (only needed if you use the ${DOCKERCONFDIR} bind-mount / per-service env_file
#     options in docker-compose.yml; many home-server stacks already define this globally) ---
# DOCKERCONFDIR=/opt/dockerconfig
