# --- controller ---
CONTROLLER_BASE=http://10.10.100.246/
CONTROLLER_PW=opendoor
# CONTROLLER_ID=my-house        # optional; defaults to device MAC (stable across DHCP changes)

# --- collection / retention ---
POLL_INTERVAL_SEC=300
HISTORY_MAX_DAYS=90

# --- service ---
PORT=8080
DATABASE_PATH=/data/data.db

# --- container user (linuxserver-style; owner of /data) ---
PUID=1000
PGID=1000
TZ=America/Chicago
