 package nl.xservices.plugins;
 
+import android.net.Uri;
+
 public class FileProvider extends androidx.core.content.FileProvider {
+  // Receiving apps (Google Drive, Gmail, Files, ...) read a shared file's MIME
+  // type from the content provider via ContentResolver.getType(), NOT from the
+  // sharing Intent's setType(). The androidx default derives the type from
+  // MimeTypeMap, which has no reliable "csv" entry and therefore falls back to
+  // "application/octet-stream" -- so CSV exports land as generic binary files.
+  // Report text/csv explicitly so they open as spreadsheets.
+  @Override
+  public String getType(Uri uri) {
+    final String path = uri.getPath();
+    if (path != null && path.toLowerCase().endsWith(".csv")) {
+      return "text/csv";
+    }
+    return super.getType(uri);
+  }
 }
